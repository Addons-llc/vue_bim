# Dev server: API calls go through the proxy below. Only set the two base
# URLs to call a server directly (cross-origin; logins won't persist).
# VITE_SITE_BASE_URL=https://buyinminutes.u.frappe.cloud
# VITE_API_BASE_URL=https://buyinminutes.u.frappe.cloud/api
VITE_PROXY_TARGET=https://buyinminutes.u.frappe.cloud
VITE_SELLING_PRICE_LIST=Selling Price
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_CLIENT_ID=

# Used only by the Vite dev server proxy. Do not prefix these with VITE_,
# because VITE_* variables are exposed to the browser bundle.
FRAPPE_API_KEY=
FRAPPE_API_SECRET=
